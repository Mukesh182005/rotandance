# ==========================================
# ROTARACT CLUB MANAGEMENT SYSTEM - ROOT ENV
# ==========================================

# Ports & Application URLs
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/rcaems?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Authentication Secrets
JWT_SECRET="rcaems_super_secret_jwt_access_key_2026"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="rcaems_super_secret_refresh_token_key_2026"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Google Drive Backup
GOOGLE_DRIVE_CLIENT_EMAIL="your-service-account@iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Email Credentials (Resend / SMTP)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="rotaract@racatria.org"

# Sentry Monitoring
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
