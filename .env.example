# ==========================================
# ROTARACT CLUB MANAGEMENT SYSTEM - ROOT ENV TEMPLATE
# ==========================================

# Ports & Application URLs
PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Database Connection (Supabase / PostgreSQL)
# Local: postgresql://postgres:password@localhost:5432/rcaems?schema=public
# Production: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres:password@localhost:5432/rcaems?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Supabase Storage & Admin Credentials
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Authentication Secrets
JWT_SECRET="rcaems_super_secret_jwt_access_key_2026"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="rcaems_super_secret_refresh_token_key_2026"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Cloudinary Storage Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/v1/auth/google/callback"

# Email Credentials (Resend / SMTP)
RESEND_API_KEY="re_123456789"
EMAIL_FROM="rotaract@racatria.org"

# Sentry Monitoring
SENTRY_DSN=""
